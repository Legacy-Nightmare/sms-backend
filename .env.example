# Server
PORT=

# Database
DB_HOST=localhost
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=school_management
# true for hosted Postgres outside the backend's own network (Neon, Supabase);
# false for Render's own Postgres over its internal network, and local Docker.
DB_SSL=false

# Auth
JWT_SECRET=any
JWT_EXPIRES_IN=

# Outbound email (guardian notifications)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# File uploads (student/teacher photos, website logo/hero/gallery/documents)
# — RustFS, a self-hosted S3-compatible object store (see the `rustfs`
# service in docker-compose.yml, and deploy/docker-compose.yml for
# production). RUSTFS_ACCESS_KEY/RUSTFS_SECRET_KEY are the root credentials
# the rustfs container itself uses; in production these get mapped onto
# S3_ACCESS_KEY/S3_SECRET_KEY below by deploy/docker-compose.yml, but for
# local dev (running the backend bare on the host, not in that compose
# file) set all of these directly — S3_ACCESS_KEY/S3_SECRET_KEY to the same
# values as RUSTFS_ACCESS_KEY/RUSTFS_SECRET_KEY.
# S3_ENDPOINT is the *internal* address the S3 client calls (the Docker
# network hostname http://rustfs:9000 in production; http://localhost:9000
# for local dev, via the published port in docker-compose.yml).
# STORAGE_PUBLIC_URL_BASE is the externally-reachable host a browser loads
# files from — in production, wherever nginx exposes the bucket (see
# deploy/nginx.conf's /sms-uploads/ location) — since RustFS's S3 port is
# never exposed to the public internet directly. The full object URL is
# built as {STORAGE_PUBLIC_URL_BASE}/{S3_BUCKET}/{key}.
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-southeast-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=sms-uploads
STORAGE_PUBLIC_URL_BASE=http://localhost:9000
