# Server
PORT=

# Database
DB_HOST=localhost
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=school_management
# true for hosted Postgres outside the backend's own network (Neon, Supabase);
# false for Render's own Postgres over its internal network, and local Docker.
DB_SSL=false

# Auth
JWT_SECRET=any
JWT_EXPIRES_IN=

# Outbound email (guardian notifications)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# File uploads (student photos, website logo/hero/gallery/documents) — Supabase Storage
# (its S3-compatible API — see Project Settings > Storage > S3 Connection for all of these)
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_STORAGE_BUCKET=
